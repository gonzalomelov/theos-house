{
  "data_dir": "data-glasses-live",
  "env_file": "~/.parenting-agent.env",
  "brain": {
    "provider": "openai_compatible",
    "model": "meta-models/muse-spark-open-1026",
    "base_url": "https://inference.baseten.co/v1",
    "key_env": "BASETEN_API_KEY",
    "max_tokens": 4096,
    "reasoning_effort": "low"
  },
  "baby_log": {
    "provider": "babybuddy",
    "url_env": "BABYBUDDY_URL",
    "token_env": "BABYBUDDY_TOKEN",
    "child": "test-baby"
  },
  "allowed_tools": [
    "log_baby_event",
    "read_baby_log",
    "baby_summary",
    "remember",
    "current_time",
    "start_changing_table",
    "finish_changing_table",
    "start_bath",
    "finish_bath"
  ],
  "plugins": [
    "parenting_agent.agent.console:Console",
    "parenting_agent.glasses:Glasses",
    "parenting_agent.changing_table:ChangingTable",
    "parenting_agent.camera_skill:CameraSkills",
    "parenting_agent.dog_watch:GlassesDogWatch"
  ],
  "max_steps": 6,
  "glasses": {
    "port": 8766,
    "host": "127.0.0.1"
  },
  "changing_table": {
    "skill": "skills/changing-table.json",
    "source": "glasses",
    "arm": "command",
    "channel": "glasses",
    "preload_confirm": true,
    "keep_confirm": true
  },
  "camera_skills": [
    {
      "skill": "skills/bath.json",
      "source": "glasses",
      "channel": "glasses"
    }
  ],
  "dog_watch_glasses": {
    "source": "glasses",
    "every_s": 0.25,
    "room": "changing table",
    "alert_to": "capture"
  },
  "house": {
    "live": false
  }
}
