{
  "data_dir": "data",
  "env_file": "~/.parenting-agent.env",
  "brain": {"provider": "openai_compatible", "model": "meta-models/muse-spark-open-1026",
            "base_url": "https://inference.baseten.co/v1", "key_env": "BASETEN_API_KEY", "max_tokens": 800},
  "allowed_tools": ["log_baby_event", "read_baby_log", "remember", "current_time"],
  "plugins": ["parenting_agent.agent.console:Console"],
  "max_steps": 6
}
