{
  "data_dir": "/data",
  "env_file": "/nonexistent",
  "brain": {
    "provider": "claude",
    "model": "claude-haiku-5-5",
    "max_tokens": 800
  },
  "baby_log": {
    "provider": "babybuddy",
    "url_env": "BABYBUDDY_URL",
    "token_env": "BABYBUDDY_TOKEN",
    "child": "test-baby"
  },
  "allowed_tools": [
    "log_baby_event",
    "read_baby_log",
    "baby_summary",
    "remember",
    "current_time"
  ],
  "plugins": [
    "parenting_agent.agent.heartbeat:Heartbeat"
  ],
  "heartbeat": {
    "interval_s": 30
  },
  "max_steps": 6
}
