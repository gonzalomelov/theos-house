{
  "data_dir": "data",
  "env_file": "~/.parenting-agent.env",
  "brain": {
    "provider": "claude",
    "model": "claude-haiku-5-5",
    "max_tokens": 800
  },
  "baby_log": {
    "provider": "babybuddy",
    "url_env": "BABYBUDDY_URL",
    "token_env": "BABYBUDDY_TOKEN",
    "child": "test-baby"
  },
  "allowed_tools": [
    "log_baby_event",
    "read_baby_log",
    "baby_summary",
    "remember",
    "current_time",
    "start_changing_table",
    "finish_changing_table",
    "start_bath",
    "finish_bath",
    "cabin_ready",
    "car_status"
  ],
  "plugins": [
    "parenting_agent.agent.console:Console",
    "parenting_agent.changing_table:ChangingTable",
    "parenting_agent.camera_skill:CameraSkills",
    "parenting_agent.channels.telegram:Telegram",
    "parenting_agent.channels.router:Router",
    "parenting_agent.tesla.trips:CarTrips"
  ],
  "max_steps": 6,
  "changing_table": {
    "skill": "skills/changing-table.json",
    "source": "phone",
    "arm": "command"
  },
  "camera_skills": [
    {"skill": "skills/bath.json", "source": "phone"}
  ],
  "telegram": {
    "token_env": "TELEGRAM_BOT_TOKEN",
    "allowed_chat_ids_env": "TELEGRAM_CHAT_ID",
    "poll_timeout_s": 25
  },
  "router": {
    "person": "person.gonza",
    "tracker": "device_tracker.gonzas_iphone",
    "ha_url": "http://127.0.0.1:18123",
    "ha_token_env": "HA_MCP_TOKEN",
    "speaker": {
      "notify": "notify.gonza_s_echo_dot_announce",
      "media_player": "media_player.gonza_s_echo_dot",
      "volume": 0.2,
      "restore_after_s": 10
    }
  },
  "car": {
    "backend": "simulated",
    "device_name": "Model 3",
    "live_commands": false,
    "parent_channel": "telegram",
    "car_seat": "rear_center",
    "trip_calendar": null
  }
}
