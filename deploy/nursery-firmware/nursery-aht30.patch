+// An AHT30 temperature and humidity sensor wired to any board over I2C. A
+// background task polls it every 10 seconds and keeps the latest of each
+// reading; sensors.read answers with those.
+
+#pragma once
+
+#include "cJSON.h"
+
+// Start the I2C bus and the polling task. Logs and does nothing else when
+// the bus can't start. A missing sensor is retried.
+void aht30_sensor_init(void);
+
+// sensors.read: the latest temperature and humidity readings, with their
+// age. A sensor with no recent reading is null; with none at all, an error.
+cJSON *aht30_sensor_command(void);
