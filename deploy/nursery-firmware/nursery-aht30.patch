+        source = (ROOT / "main/aht30_sensor.c").read_text()
+        start = source.index("// ---- Protocol (host-tested)")
+        (out / "aht30_protocol.inc").write_text(source[start:source.index("// ---- I2C driver", start)])
+        cc = shlex.split(os.environ.get("CC", "cc"))
+        flags = ["-Wall", "-Wextra", "-Werror", "-DCJSON_NESTING_LIMIT=16", "-I", str(JSON), "-I", str(out)]
+        commands = [
