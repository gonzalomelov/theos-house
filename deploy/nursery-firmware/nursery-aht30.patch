-    uint8_t raw[7];
-    if (i2c_master_transmit(s_dev, cmd, sizeof(cmd), 100) != ESP_OK) return false;
+    uint8_t raw[7] = {0};
+    esp_err_t err = i2c_master_transmit(s_dev, cmd, sizeof(cmd), 100);
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "trigger failed: %s", esp_err_to_name(err));
+        i2c_master_bus_reset(s_bus);
+        return false;
+    }
     vTaskDelay(pdMS_TO_TICKS(AHT30_MEASURE_MS));
-    if (i2c_master_receive(s_dev, raw, sizeof(raw), 100) != ESP_OK) return false;
-    if (!aht30_decode(raw, temp_c, rh_pct)) return false;
+    // The sensor may refuse a read while it is still measuring, so give it a few tries.
+    for (int attempt = 0;; attempt++) {
+        err = i2c_master_receive(s_dev, raw, sizeof(raw), 100);
+        if (err == ESP_OK && aht30_decode(raw, temp_c, rh_pct)) break;
+        if (attempt == AHT30_RETRIES - 1) {
+            ESP_LOGW(TAG, "read failed: %s, raw %02x %02x %02x %02x %02x %02x %02x, crc %02x",
+                     esp_err_to_name(err), raw[0], raw[1], raw[2], raw[3], raw[4], raw[5],
+                     raw[6], aht30_crc(raw, 6));
+            i2c_master_bus_reset(s_bus);
+            return false;
+        }
+        vTaskDelay(pdMS_TO_TICKS(50));
+    }
     int64_t now = esp_timer_get_time();
