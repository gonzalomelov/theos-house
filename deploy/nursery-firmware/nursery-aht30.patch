              CONFIG_HOMEHUB_AHT30_SDA_GPIO, CONFIG_HOMEHUB_AHT30_SCL_GPIO);
+#if CONFIG_HOMEHUB_AHT30_HTTP
+    http_start();
+#endif
 }
 
