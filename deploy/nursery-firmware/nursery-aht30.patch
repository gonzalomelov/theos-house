+# Espressif ESP32-S3-DevKitC-1 v1.1, N8R8 (ESP32-S3-WROOM-1-N8R8 or -1U-N8R8):
+# 8 MB quad flash, 8 MB octal PSRAM, an addressable RGB LED on GPIO38, the BOOT
+# button, and two USB ports, the S3's own USB-Serial-JTAG and a USB-UART
+# bridge. Load last, after sdkconfig.defaults (see README.md in this
+# directory). The N32R16V variant (octal flash, 1.8 V) is not covered.
+# Source: Espressif's ESP32-S3-DevKitC-1 v1.1 user guide and IDF's blink
+# example (sdkconfig.defaults.esp32s3).
+CONFIG_IDF_TARGET="esp32s3"
+CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
+
+# The onboard addressable LED. v1.0 boards have it on GPIO48 instead, as does
+# the Aideepen N16R8 clone: set CONFIG_HOMEHUB_LED_STRIP_GPIO=48 in
+# the build directory's sdkconfig (see README.md).
+CONFIG_HOMEHUB_LED_BACKEND_DEVKIT_GPIO27=y
+CONFIG_HOMEHUB_LED_STRIP_GPIO=48
+# Green first, as WS2812s usually are; unlike the C5 DevKitC-1's LED.
+CONFIG_HOMEHUB_LED_RGB_ORDER=n
+# BOOT button, active low.
+CONFIG_HOMEHUB_BUTTON_GPIO=0
+
+# 8 MB quad flash, as listed for the N8R8 module.
+CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
+CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
+CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
+CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
+
+# Octal PSRAM holds the TLS buffers and keeps the home-network tunnel on.
+CONFIG_SPIRAM=y
+CONFIG_SPIRAM_MODE_OCT=y
+CONFIG_SPIRAM_MODE_QUAD=n
+CONFIG_SPIRAM_SPEED_80M=y
+
+# The BLE controller already takes ~70 KB of internal RAM on the S3; keep the
+# NimBLE host's allocations in PSRAM so pairing has room.
+CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
+
+# Theo's room: an AHT30 on SDA GPIO4, SCL GPIO5 (sensors.read).
+CONFIG_HOMEHUB_AHT30_SENSOR=y
