+#if CONFIG_HOMEHUB_AHT30_HTTP
+// GET /sensors answers with the same JSON as sensors.read, read only, so a home
+// server on the LAN can poll the sensor without the gadget being paired.
+static esp_err_t sensors_get(httpd_req_t *req) {
+    cJSON *result = aht30_sensor_command();
+    char *json = result ? cJSON_PrintUnformatted(result) : NULL;
+    cJSON_Delete(result);
+    if (!json) return httpd_resp_send_500(req);
+    httpd_resp_set_type(req, "application/json");
+    esp_err_t err = httpd_resp_sendstr(req, json);
+    cJSON_free(json);
+    return err;
+}
+
+static void http_start(void) {
+    httpd_config_t cfg = HTTPD_DEFAULT_CONFIG();
+    httpd_handle_t server = NULL;
+    esp_err_t err = httpd_start(&server, &cfg);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "HTTP server failed: %s", esp_err_to_name(err));
+        return;
+    }
+    const httpd_uri_t uri = {.uri = "/sensors", .method = HTTP_GET, .handler = sensors_get};
+    httpd_register_uri_handler(server, &uri);
+    ESP_LOGI(TAG, "serving readings on port %d at /sensors", cfg.server_port);
+}
+#endif
+
 void aht30_sensor_init(void) {
     i2c_master_bus_config_t bus_cfg = {
         .i2c_port = -1,
@@ -219,6 +250,9 @@ void aht30_sensor_init(void) {
