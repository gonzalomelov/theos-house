# ~/apps/pa-families.env on the Vostro, mode 600. Only these names. Never commit or print the values.
# Muse Spark Open on Baseten, the brain. Claude is the fallback when a Muse call errors.
BASETEN_API_KEY=
ANTHROPIC_API_KEY=
TELEGRAM_FAMILIES_BOT_TOKEN=
# The second bot's username without @, for the invite links.
PA_FAMILIES_BOT_USERNAME=
# Gonza's own Telegram user ids, comma separated. Their rows are internal and never count for the KR.
PA_FAMILIES_INTERNAL_USERS=
