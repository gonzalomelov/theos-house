# ~/apps/parenting-agent.env on the Vostro, mode 600. Written by `sh deploy/agent.sh push-env`, never committed.
# The Baby Buddy and Home Assistant addresses are set in compose.yml, not here.
# Muse Spark Open on Baseten is the brain (issue #4), the only model. When a Muse call errors the fixed rules answer.
BASETEN_API_KEY=
BABYBUDDY_TOKEN=
# Home Assistant token. Named HA_MCP_TOKEN on purpose: the house layer goes live only with HA_TOKEN (issue #9).
HA_MCP_TOKEN=
# For the Telegram channel (issue #3). Passed through, unused until that plug-in ships.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ceci's Telegram chat id, once her phone is set up. Until then the log says her channel is not connected.
TELEGRAM_CECI_CHAT_ID=
